# Converts a raw 68000 binary into a C++ header holding big-endian 16-bit words.
#
# Usage:
#   cmake -DSRC_FILE=<input.bin> -DDST_FILE=<TraceRoutine.h> -P BinToHeader.cmake
#
# Generates:
#   static const uint16_t gwTraceRoutine[] = { 0x1234, ... };
#   #define TRACE_ROUTINE_SIZE_BYTES <n>
# The binary is padded with a zero byte if its size is odd.

if(NOT SRC_FILE OR NOT DST_FILE)
    message(FATAL_ERROR "BinToHeader: SRC_FILE and DST_FILE must be defined")
endif()

file(READ ${SRC_FILE} HEX_DATA HEX)
string(LENGTH "${HEX_DATA}" HEX_LENGTH)
math(EXPR SIZE_BYTES "${HEX_LENGTH} / 2")
if(SIZE_BYTES EQUAL 0)
    message(FATAL_ERROR "BinToHeader: ${SRC_FILE} is empty")
endif()

# Pad to an even number of bytes
math(EXPR ODD "${SIZE_BYTES} % 2")
if(ODD)
    string(APPEND HEX_DATA "00")
    math(EXPR HEX_LENGTH "${HEX_LENGTH} + 2")
endif()
math(EXPR WORD_COUNT "${HEX_LENGTH} / 4")

set(WORDS "")
set(LINE "   ")
set(COL 0)
set(INDEX 0)
while(INDEX LESS HEX_LENGTH)
    string(SUBSTRING "${HEX_DATA}" ${INDEX} 4 WORD)
    string(APPEND LINE " 0x${WORD},")
    math(EXPR INDEX "${INDEX} + 4")
    math(EXPR COL "${COL} + 1")
    if(COL EQUAL 8)
        string(APPEND WORDS "${LINE}\n")
        set(LINE "   ")
        set(COL 0)
    endif()
endwhile()
if(COL GREATER 0)
    string(APPEND WORDS "${LINE}\n")
endif()

set(CONTENT "// Generated by cmake/BinToHeader.cmake from Brico68k/Trace.s. Do not edit.
#pragma once

#include <stdint.h>

#define TRACE_ROUTINE_SIZE_BYTES ${SIZE_BYTES}

static const uint16_t gwTraceRoutine[] =
{
${WORDS}};
")

# Only rewrite the file when its content changes
set(OLD_CONTENT "")
if(EXISTS ${DST_FILE})
    file(READ ${DST_FILE} OLD_CONTENT)
endif()
if(NOT OLD_CONTENT STREQUAL CONTENT)
    file(WRITE ${DST_FILE} "${CONTENT}")
endif()
message(STATUS "BinToHeader: ${SIZE_BYTES} bytes (${WORD_COUNT} words) -> ${DST_FILE}")
