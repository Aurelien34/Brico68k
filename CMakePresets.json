{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default",
            "binaryDir": "${sourceDir}/build"
        }
    ],
    "buildPresets": [
        {
            "name": "build",
            "displayName": "Build ROM",
            "configurePreset": "default"
        },
        {
            "name": "run",
            "displayName": "Build + send to BricoNeo RAM (run)",
            "configurePreset": "default",
            "targets": ["run"]
        },
        {
            "name": "store",
            "displayName": "Build + send to BricoNeo and store in bank 0 (store)",
            "configurePreset": "default",
            "targets": ["store"]
        }
    ]
}
